# backend/.env 템플릿.
#   cp backend/.env.example backend/.env  후 값을 채운다.
#   .env 는 git 에 올라가지 않는다. 팀원에게는 메신저/드라이브로 전달할 것.
#
#   [중요] docker compose 로 띄울 때는 프로젝트 루트에도 이 파일이 보여야 한다.
#          compose 의 ${VAR} 치환은 루트 .env 만 읽기 때문이다. 심볼릭 링크로 연결한다:
#            ln -s backend/.env .env

# ── 인증 (필수, 기본값 없음 — 비우면 서버가 기동하지 않는다) ──────────
#   생성: openssl rand -base64 48
JWT_SECRET=
REFRESH_PEPPER=

# ── DB ───────────────────────────────────────────────────────────────
DB_NAME=appdb
DB_USERNAME=appuser
DB_PASSWORD=
# DB_URL 은 compose 가 주입한다. 로컬에서 직접 띄울 때만 지정:
# DB_URL=jdbc:postgresql://localhost:5433/appdb

# 최초 배포로 스키마가 만들어진 뒤에는 validate 로 바꿀 것 (운영 중 자동 스키마 변경 방지).
JPA_DDL_AUTO=update
SQL_LOG_LEVEL=info

# ── 도메인 (배포 시 반드시 실제 도메인으로) ──────────────────────────
#   사설 IP(192.168.x.x)로 두면 서버는 떠도 앱에서 사진이 안 보인다.
STORAGE_PUBLIC_BASE_URL=https://ducktack.example.com
#   company-web 도메인. "*" 금지. 여러 개면 쉼표로 구분.
CORS_ALLOWED_ORIGINS=https://ducktack.example.com

# ── 외부 API 키 ──────────────────────────────────────────────────────
#   [필수] 카카오 로컬 API — 업체 키워드 검색
#     https://developers.kakao.com  (내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_REST_KEY=

#   [필수] 네이버 NCP Geocoding — 주소를 위경도로 변환 (관리자 제휴업체 등록)
#     https://console.ncloud.com  (Maps > Geocoding)
NAVER_NCP_CLIENT_ID=
NAVER_NCP_CLIENT_SECRET=

#   [필수] LLM — AI 하자 진단 + DIY 가이드 생성. 없으면 진단 기능이 동작하지 않는다.
#     https://aistudio.google.com/apikey  (무료, 카드등록 불필요)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ── 메일 (이메일 인증코드 발송) ──────────────────────────────────────
#   비워두면 메일을 보내지 않고 인증코드가 서버 로그에만 찍힌다. 개발 중엔 이대로 둬도 된다.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# ── 커뮤니티 욕설 필터 ───────────────────────────────────────────────
#   moderation-server 컨테이너를 띄우지 않을 거면 false 로 둘 것.
MODERATION_ENABLED=true
MODERATION_FAIL_OPEN=true
